{
  "name": "solophone-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial client for the Light Phone cloud API: sync the Notes tool with local markdown, toggle developer mode, list tools",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "light": "tsx src/cli.ts",
    "light:op": "op run --env-file=.env -- tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
