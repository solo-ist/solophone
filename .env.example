# Light account credentials (same names the community light-phone-api uses).
# Copy to .env — the .env file is gitignored. Source of truth is your Light account.
#
# Preferred: 1Password secret references, resolved at runtime by `op run`
# (npm run light:op -- <cmd>) so plaintext never touches disk:
#   LIGHT_EMAIL=op://<vault>/<item>/username
#   LIGHT_PASSWORD=op://<vault>/<item>/password
# Plaintext values also work if you run `npm run light -- <cmd>` directly.
LIGHT_EMAIL=you@example.com
LIGHT_PASSWORD=

# Only needed if the account has more than one device. Phone number is
# US-style, no country code (the API matches on the last 10 digits).
# LIGHT_PHONE_NUMBER=
# LIGHT_DEVICE_ID=
